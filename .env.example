# Copy to .env (git-ignored) and set your own local passwords. Used by `docker compose` and scripts/dev.ps1.
MARIADB_PASSWORD=change-me
MARIADB_ROOT_PASSWORD=change-me-too
# Host ports; change them if 3306 / 6379 are already taken on your machine.
MARIADB_PORT=3306
REDIS_PORT=6379
# Optional: MariaDB schema scripts/dev.ps1 connects to (compose creates "flashsale").
# MARIADB_DATABASE=flashsale
# Optional: use a database that is not the local compose one (also needs -AllowRemote on dev.ps1).
# MARIADB_HOST=db.example.internal
# MARIADB_USER=flashsale
# MARIADB_SSL_MODE=Required
# REDIS_HOST=localhost
# Or give one ready-made connection string instead of the MARIADB_* keys above:
# ConnectionStrings__MariaDb=Server=db.example.internal;Port=3306;Database=scratch;User ID=app;Password=...;SslMode=Required

# Lazada Affiliate Open API (affiliate portal > INTEGRATION > Open API). Put real values in .env.lazada (git-ignored), never here.
# Lazada__Affiliate__AppKey=
# Lazada__Affiliate__AppSecret=
# Lazada__Affiliate__UserToken=
# Optional: Lazada__Affiliate__CategoryIds__0=  Lazada__Affiliate__ProductIds__0=  Lazada__Affiliate__PageSize=50  Lazada__Affiliate__MaxPages=2  Lazada__Affiliate__MaxTrackingLinks=0

# File feeds exported from a marketplace portal (see docs/marketplaces.md). One per marketplace: Shopee, TikTok, Lazada.
# FileFeeds__Shopee__Path=C:\exports\shopee
# FileFeeds__Shopee__IntervalMinutes=60
# FileFeeds__Shopee__Columns__Price=Sale Price
